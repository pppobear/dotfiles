// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "buffer_line_height": "standard",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "ui_font_family": "PingFang SC",
  "buffer_font_family": "Maple Mono NF CN",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "model": "gpt-5.6-sol"
      },
      "type": "registry"
    },
    "pi-acp": {
      "default_config_options": {
        "thought_level": "xhigh",
        "model": "openai-codex/gpt-5.6-luna"
      },
      "default_model": "openai-codex/gpt-5.5",
      "type": "registry"
    },
    "omp": {
      "type": "custom",
      "command": "/etc/profiles/per-user/enoch/bin/omp",
      "args": ["acp"]
    },
    "pi-wn": {
      "default_model": "openai-codex/gpt-5.5",
      "type": "custom",
      "command": "/etc/profiles/per-user/enoch/bin/pi-acp",
      "env": {
        "PI_CODING_AGENT_DIR": "/Users/enoch/.pi/agent-wn"
      }
    },
    "pi-f": {
      "default_model": "openai-codex/gpt-5.4-mini",
      "type": "custom",
      "command": "/etc/profiles/per-user/enoch/bin/pi-acp",
      "env": {
        "PI_CODING_AGENT_DIR": "/Users/enoch/.pi/agent-f"
      }
    },
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "ssh_connections": [
    {
      "host": "192.168.5.23",
      "username": "enoch",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/enoch/Projects/zhenxin/fungo-service/"
          ]
        }
      ],
      "nickname": "DevFedora"
    }
  ],
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": false
    },
    "google": {
      "api_url": "https://co.yes.vg/team/gemini"
    }
  },
  "agent": {
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b"
            }
          ]
        }
      }
    },
    "dock": "left",
    "default_model": {
      "speed": "standard",
      "effort": "xhigh",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol"
    },
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
    "sort_by_path": false
  },
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "edit_predictions": {
    "provider": "none",
    "mode": "subtle"
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "light",
    "light": "Everforest Light Hard (material)",
    "dark": "Catppuccin Mocha"
  },
  "lsp": {
    "jdtls": {
      "settings": {
        "java_home": "/Users/enoch/.local/share/jdk21",
        "lombok_support": true,
        "jdtls_launcher": "/etc/profiles/per-user/enoch/bin/jdtls"
      },
      "initialization_options": {
        "bundles": [],
        "settings": {
          "java": {
            "home": "/Users/enoch/.local/share/jdk21",
            "configuration": {
              "maven": {
                "globalSettings": null,
                "userSettings": "/Users/enoch/.m2/settings.xml"
              }
            },
            "maven": {
              "downloadSources": true
            },
            "import": {
              "maven": {
                "enabled": true
              }
            }
          }
        }
      }
    }
  }
}
